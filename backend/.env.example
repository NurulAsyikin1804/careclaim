# Backend (claims service). Only the middleware should ever call this service.
PORT=3000
# 127.0.0.1 = reachable from this machine only. Use 0.0.0.0 inside Docker / Cloud Run.
BACKEND_HOST=127.0.0.1

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Server-side secret. Never put this in frontend code or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Shared secret between middleware and backend. Must be identical in both .env files.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=replace-with-a-long-random-value
